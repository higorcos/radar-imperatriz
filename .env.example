# Copie para .env.local e preencha. Nunca versione o .env.local.

# PostgreSQL. Local: docker compose (porta 5434). Produção: string de conexão do Supabase
# (Project Settings > Database > Connection string, modo "Session pooler").
DATABASE_URL=postgres://radar:radar_dev_local@127.0.0.1:5434/radar_imperatriz

# Senha de acesso ao painel (mínimo 10 caracteres).
APP_PASSWORD=

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com:  openssl rand -hex 32
SESSION_SECRET=

# Segredo exigido pela rota /api/cron/collect (header Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Chave da API do Claude (Anthropic). Sem ela, os recursos de IA ficam desativados e a interface avisa.
ANTHROPIC_API_KEY=

# Opcional: modelo usado pela IA (padrão: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
